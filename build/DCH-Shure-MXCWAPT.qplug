local module_loaders, module_values = {}, {}
local function require(name)
  if module_values[name] ~= nil then return module_values[name] end
  local loader = assert(module_loaders[name], 'Missing bundled module: ' .. name)
  local value = loader()
  module_values[name] = value
  return value
end

