}

local function add(name, scope, verbs, values, control, notes)
  Commands[name] = {
    name = name,
    scope = scope,
    get = verbs.get == true,
    set = verbs.set == true,
    rep = verbs.rep == true,
    values = values or "",
    control = control or "",
    notes = notes or "",
  }
end

